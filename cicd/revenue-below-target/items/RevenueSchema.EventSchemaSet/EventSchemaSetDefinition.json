{
  "eventTypes": [
    {
      "id": "${event_name}",
      "description": "A regional revenue variance crossing strictly below the monitored target threshold.",
      "category": "BusinessEventType",
      "format": "CloudEvents/1.0",
      "envelopeMetadata": {
        "id": {
          "type": "string",
          "required": true
        },
        "type": {
          "type": "string",
          "required": true,
          "value": "${event_name}"
        },
        "source": {
          "type": "string",
          "required": true
        },
        "specversion": {
          "type": "string",
          "required": true
        },
        "time": {
          "type": "timestamp",
          "required": true
        },
        "datacontenttype": {
          "type": "string",
          "required": true
        },
        "dataversion": {
          "type": "string",
          "required": true
        },
        "dataschema": {
          "type": "string",
          "required": true
        }
      },
      "schemaUrl": "${schema_url}",
      "schemaFormat": "Avro/1.12.0"
    }
  ],
  "schemas": [
    {
      "id": "${event_name}",
      "format": "Avro/1.12.0",
      "versions": [
        {
          "id": "v1",
          "format": "Avro/1.12.0",
          "schema": "{\"type\": \"record\", \"name\": \"${event_name}\", \"fields\": [{\"name\": \"region\", \"type\": \"string\"}, {\"name\": \"period_start\", \"type\": \"string\"}, {\"name\": \"revenue\", \"type\": \"double\"}, {\"name\": \"target\", \"type\": \"double\"}, {\"name\": \"variance_pct\", \"type\": \"double\"}, {\"name\": \"detected_at\", \"type\": \"string\"}]}"
        }
      ]
    }
  ]
}

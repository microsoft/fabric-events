{
  "eventTypes": [
    {
      "id": "${event_name}",
      "description": "A stock shortage already detected by the warehouse management system.",
      "category": "BusinessEventType",
      "format": "CloudEvents/1.0",
      "envelopeMetadata": {
        "id": {
          "type": "string",
          "required": true
        },
        "type": {
          "type": "string",
          "required": true,
          "value": "${event_name}"
        },
        "source": {
          "type": "string",
          "required": true
        },
        "specversion": {
          "type": "string",
          "required": true
        },
        "time": {
          "type": "timestamp",
          "required": true
        },
        "datacontenttype": {
          "type": "string",
          "required": true
        },
        "dataversion": {
          "type": "string",
          "required": true
        },
        "dataschema": {
          "type": "string",
          "required": true
        }
      },
      "schemaUrl": "${schema_url}",
      "schemaFormat": "Avro/1.12.0"
    }
  ],
  "schemas": [
    {
      "id": "${event_name}",
      "format": "Avro/1.12.0",
      "versions": [
        {
          "id": "v1",
          "format": "Avro/1.12.0",
          "schema": "{\"type\": \"record\", \"name\": \"${event_name}\", \"fields\": [{\"name\": \"product_id\", \"type\": \"string\"}, {\"name\": \"product_name\", \"type\": \"string\"}, {\"name\": \"store_id\", \"type\": \"string\"}, {\"name\": \"current_stock\", \"type\": \"int\"}, {\"name\": \"threshold\", \"type\": \"int\"}, {\"name\": \"supplier_id\", \"type\": \"string\"}, {\"name\": \"detected_at\", \"type\": \"string\"}]}"
        }
      ]
    }
  ]
}

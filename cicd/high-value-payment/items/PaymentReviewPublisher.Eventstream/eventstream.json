      "schema": {"columns": [
        {"name": "transaction_id", "type": "Nvarchar(max)"},
        {"name": "payment_method", "type": "Nvarchar(max)"},
        {"name": "amount", "type": "Float"},
        {"name": "currency", "type": "Nvarchar(max)"},
        {"name": "store_id", "type": "Nvarchar(max)"},
        {"name": "processed_at", "type": "Nvarchar(max)"}

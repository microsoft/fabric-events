{
  "eventTypes": [{
    "id": "${event_name}",
    "description": "A payment strictly above 5000 in its original currency.",
    "category": "BusinessEventType",
    "format": "CloudEvents/1.0",
    "envelopeMetadata": {
      "id": {"type": "string", "required": true},
      "type": {"type": "string", "required": true, "value": "${event_name}"},
      "source": {"type": "string", "required": true},
      "specversion": {"type": "string", "required": true},
      "time": {"type": "timestamp", "required": true},
      "datacontenttype": {"type": "string", "required": true},
      "dataversion": {"type": "string", "required": true},
      "dataschema": {"type": "string", "required": true}
    },
    "schemaUrl": "${schema_url}",
    "schemaFormat": "Avro/1.12.0"
  }],
  "schemas": [{
    "id": "${event_name}",
    "format": "Avro/1.12.0",
    "versions": [{
      "id": "v1",
      "format": "Avro/1.12.0",
      "schema": "{\"type\":\"record\",\"name\":\"${event_name}\",\"fields\":[{\"name\":\"transaction_id\",\"type\":\"string\"},{\"name\":\"payment_method\",\"type\":\"string\"},{\"name\":\"amount\",\"type\":\"float\"},{\"name\":\"currency\",\"type\":\"string\"},{\"name\":\"store_id\",\"type\":\"string\"},{\"name\":\"processed_at\",\"type\":\"string\"}]}"
    }]
  }]
}

{
  "properties": {
    "displayName": "${flow_name}",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_an_activator_rule_is_triggered": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "connectionInfo": "${native_connection_info}"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_dataactivator",
              "connectionName": "shared_dataactivator",
              "operationId": "CreatePowerAutomateWorkflow"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Persist_hold": {
          "runAfter": {},
          "type": "Http",
          "inputs": {
            "uri": "@concat('${order_api_base_url}/orders/', uriComponent(triggerBody()?['customProperties/order_id']), '/hold')",
            "body": {
              "risk_score": "@float(triggerBody()?['customProperties/risk_score'])",
              "order_id": "@triggerBody()?['customProperties/order_id']"
            },
            "method": "POST",
            "headers": {
              "Content-Type": "application/json",
              "x-activation-id": "@triggerBody()?['eventId']",
              "x-functions-key": "${order_api_key}"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        }
      },
      "outputs": {}
    },
    "connectionReferences": {
      "shared_dataactivator": {
        "connectionName": "${data_activator_connection_name}",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_dataactivator"
      }
    },
    "state": "Started"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order risk decision deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configuration_version", "scenario_id", "environment", "workspace_id",
    "resource_prefix", "event_name", "resource_names", "flow_environment_id",
    "data_activator_connection_name", "flow_names", "azure"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "configuration_version": {"const": "1.0"},
    "scenario_id": {"const": "fraud"},
    "environment": {"enum": ["fabric", "daily", "msit"]},
    "workspace_id": {"type": ["string", "null"], "format": "uuid"},
    "resource_prefix": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{2,39}$"},
    "event_name": {
      "type": "string", "minLength": 3, "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "resource_names": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "publisher", "activator", "eventhouse", "database"],
      "properties": {
        "schema": {"$ref": "#/$defs/name"},
        "publisher": {"$ref": "#/$defs/name"},
        "activator": {"$ref": "#/$defs/name"},
        "eventhouse": {"$ref": "#/$defs/name"},
        "database": {"$ref": "#/$defs/name"}
      }
    },
    "flow_environment_id": {"type": ["string", "null"], "format": "uuid"},
    "data_activator_connection_name": {
      "type": ["string", "null"], "pattern": "^shared-dataactivator-[a-zA-Z0-9-]+$"
    },
    "flow_names": {
      "type": "object", "additionalProperties": false,
      "required": ["hold", "manual_review", "release"],
      "properties": {
        "hold": {"$ref": "#/$defs/name"},
        "manual_review": {"$ref": "#/$defs/name"},
        "release": {"$ref": "#/$defs/name"}
      }
    },
    "azure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mode", "subscription_id", "resource_group", "location",
        "storage_account", "function_app", "identity_name", "table_name"
      ],
      "properties": {
        "mode": {"enum": ["provision", "existing"]},
        "subscription_id": {"type": ["string", "null"], "format": "uuid"},
        "resource_group": {"type": "string", "pattern": "^([A-Za-z0-9_().-]{1,90})?$"},
        "location": {"type": "string", "pattern": "^[a-z0-9]{2,40}$"},
        "storage_account": {"type": "string", "pattern": "^[a-z0-9]{3,24}$"},
        "function_app": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,58}[a-z0-9]$"},
        "identity_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,99}$"},
        "table_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{2,62}$"}
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string", "minLength": 3, "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9 _-]{1,98}[A-Za-z0-9_-]$",
      "not": {"pattern": "^([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])$"}
    }
  }
}

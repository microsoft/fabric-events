{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abandoned Cart Recovery configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "tenant_id", "workspace_id", "auth_provider", "resource_prefix",
               "event_name", "resource_names", "accept_preview_apis", "test_recipient"],
  "properties": {
    "$schema": {"type": "string"},
    "scenario_id": {"const": "abandoned-cart-recovery"},
    "tenant_id": {"type": ["string", "null"], "format": "uuid"},
    "workspace_id": {"type": ["string", "null"], "format": "uuid"},
    "auth_provider": {"enum": ["azure_cli", "fabric_cli"]},
    "resource_prefix": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{2,39}$"},
    "event_name": {"type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
    "accept_preview_apis": {"type": "boolean"},
    "test_recipient": {"type": ["string", "null"], "maxLength": 254, "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"},
    "resource_names": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "publisher", "activator", "task_store"],
      "properties": {
        "schema": {"type": "string", "minLength": 3, "maxLength": 20, "pattern": "^[A-Za-z][A-Za-z0-9_-]+$"},
        "publisher": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,99}$"},
        "activator": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,99}$"},
        "task_store": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,99}$"}
      }
    }
  }
}
